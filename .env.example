MEMBER_AREA_DB_HOST=127.0.0.1
MEMBER_AREA_DB_PORT=3306
MEMBER_AREA_DB_NAME=bogensport
MEMBER_AREA_DB_USER=root
MEMBER_AREA_DB_PASSWORD=
MEMBER_AREA_DB_CHARSET=utf8mb4

MEMBER_AREA_JWT_SECRET=change-me-to-a-long-random-secret
MEMBER_AREA_JWT_ISSUER=badoldesloer-bogensport.de
MEMBER_AREA_JWT_AUDIENCE=badoldesloer-bogensport.de
MEMBER_AREA_JWT_TTL_SECONDS=7200
MEMBER_AREA_JWT_COOKIE_NAME=bobs_member_token
MEMBER_AREA_JWT_SECURE_COOKIE=false

MEMBER_AREA_SETUP_TOKEN_HASH=
MEMBER_AREA_DIAGNOSTICS_TOKEN_HASH=
MEMBER_AREA_NEWS_IMAGE_RETENTION_DAYS=30

# One-time bootstrap value: generate a token in the easyVerein dashboard (Einstellungen ->
# easyVerein API) and set it here once. After the first run it's stored in the
# easyverein_tokens DB table and auto-refreshed from there - this env var is then unused
# unless that table is ever reset.
EASYVEREIN_API_TOKEN=

MYSQL_DATABASE=bogensport
MYSQL_ALLOW_EMPTY_PASSWORD=yes
